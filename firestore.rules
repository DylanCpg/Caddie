rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Une liste partagée = un "foyer" identifié par un code secret de 10 caractères.
    // Il faut être connecté (connexion anonyme automatique) ET connaître le code.
    // Il est impossible de lister les foyers existants.
    match /households/{code}/{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
